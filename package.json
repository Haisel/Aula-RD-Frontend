{
  "name": "aulard-frontend",
  "version": "0.1.0",
  "description": "Aula RD — frontend (Bootstrap 5.3 + Vite + Handlebars + JS con JSDoc). Landing de suscripción y dashboards.",
  "scripts": {
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && vite build && node scripts/build-html.mjs",
    "preview": "npx vite preview --outDir dist",
    "tokens": "node scripts/build-tokens.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/scss/**/*.scss\"",
    "format": "prettier --write \"src/**/*.{js,scss,html,hbs,json}\" \"*.{js,json,md}\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs": "jsdoc -c jsdoc.json",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "build:html": "node scripts/build-html.mjs",
    "build:single": "npm run tokens && AU_SINGLE=1 vite build && AU_SINGLE=1 node scripts/build-html.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@popperjs/core": "^2.11.8",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.6.1",
    "choices.js": "^11.2.4",
    "datatables.net-bs5": "^2.3.8",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "flatpickr": "^4.6.13",
    "handlebars": "^4.7.10",
    "imask": "^7.6.1",
    "jsbarcode": "^3.12.3",
    "qr-code-styling": "^1.9.2",
    "quill": "^2.0.3",
    "signature_pad": "^5.1.4",
    "sortablejs": "^1.15.7",
    "sweetalert2": "^11.26.25",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "docdash": "^2.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "jsdoc": "^4.0.5",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-handlebars": "^2.0.3",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
