{
  "//": "Solo para verificaci\u00f3n de tipos JSDoc (npm run typecheck). No emite archivos.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/js/*"],
      "@data/*": ["./src/data/*"]
    }
  },
  "include": ["src/js/**/*.js", "src/data/**/*.js", "src/js/**/*.d.ts"]
}
