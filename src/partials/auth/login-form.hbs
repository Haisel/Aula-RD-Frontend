{{!-- Formulario de inicio de sesión reutilizable (spec 013, V-01). Lo comparten las variantes: cambia la estructura de la página, no el formulario.
      Parámetros: heading (si falta, no se pinta el h1), lead, social="true" para el acceso con proveedor externo. --}}
<form class="au-login-form" data-au-validate="login" data-au-submit="event" data-au-success="Datos válidos (demostración). Con su API JWT use data-au-submit=&quot;login&quot; y configure auth en au-config." action="#" method="post" novalidate>
  {{#if heading}}
  <div>
    <h1>{{heading}}</h1>
    {{#if lead}}<p class="text-body-secondary mb-0">{{lead}}</p>{{/if}}
  </div>
  {{/if}}
  <div class="alert alert-danger d-none" role="alert" data-au-form-error></div>
  <div>
    <label class="form-label" for="email">Correo</label>
    <input class="form-control form-control-lg" id="email" name="email" type="email" autocomplete="username" placeholder="nombre@colegio.edu.do">
  </div>
  <div>
    <div class="d-flex justify-content-between"><label class="form-label" for="password">Contraseña</label><a class="small fw-semibold" href="recuperar-contrasena.html">¿La olvidó?</a></div>
    <div class="input-group input-group-lg">
      <input class="form-control" id="password" name="password" type="password" autocomplete="current-password">
      <button class="btn btn-outline-primary" type="button" data-au-password-toggle="#password" aria-label="Mostrar u ocultar la contraseña"><i class="bi bi-eye" aria-hidden="true"></i></button>
    </div>
  </div>
  <div class="form-check">
    <input class="form-check-input" type="checkbox" id="recordar" name="recordar">
    <label class="form-check-label" for="recordar">Mantener la sesión en este dispositivo</label>
  </div>
  <button class="btn btn-primary btn-lg w-100" type="submit">Entrar</button>
  {{#if social}}
  <div class="au-auth-divider" role="separator"><span>o continúe con</span></div>
  <div class="d-grid gap-2">
    <button class="btn btn-outline-primary" type="button" data-au-action="toast" data-au-type="info" data-au-message="Demostración: aquí se inicia el acceso con Google."><i class="bi bi-google" aria-hidden="true"></i>Continuar con Google</button>
    <button class="btn btn-outline-primary" type="button" data-au-action="toast" data-au-type="info" data-au-message="Demostración: aquí se inicia el acceso con Microsoft."><i class="bi bi-microsoft" aria-hidden="true"></i>Continuar con Microsoft</button>
  </div>
  {{/if}}
  <p class="text-center text-body-secondary small mb-0">¿Su institución aún no usa Aula RD? <a href="suscribir.html">Suscríbala</a></p>
</form>
