{{!-- {{> components/profile-contact}} Correo, teléfono y ubicación del perfil. Contexto: profile.email, phone, location. --}}
<ul class="au-profile-contact">
  <li><i class="bi bi-envelope" aria-hidden="true"></i><span class="visually-hidden">Correo: </span>{{profile.email}}</li>
  <li><i class="bi bi-telephone" aria-hidden="true"></i><span class="visually-hidden">Teléfono: </span>{{profile.phone}}</li>
  <li><i class="bi bi-geo-alt" aria-hidden="true"></i><span class="visually-hidden">Ubicación: </span>{{profile.location}}</li>
</ul>
