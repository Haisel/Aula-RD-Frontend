{{!-- Arquetipo "Configuración" (spec 013): secciones en pestañas con campos. Contexto: module.settings.sections = [{ id, title, description, fields[] }].
      Campo: { id, label, type: text|email|tel|number|select|switch, value, options[], checked, readonly, help }. Los cambios no se guardan: es una demostración. --}}
<section class="card au-settings" aria-labelledby="mod-config">
  <div class="card-body" data-au-tabs>
    <h2 class="visually-hidden" id="mod-config">Ajustes</h2>
    <ul class="nav nav-tabs mb-4">
      {{#each module.settings.sections}}
      <li class="nav-item"><button class="nav-link{{#if @first}} active{{/if}}" type="button" data-bs-toggle="tab" data-bs-target="#panel-{{id}}">{{title}}</button></li>
      {{/each}}
    </ul>
    <div class="tab-content">
      {{#each module.settings.sections}}
      <div class="tab-pane fade{{#if @first}} show active{{/if}}" id="panel-{{id}}">
        <h3 class="au-card-title mb-1">{{title}}</h3>
        <p class="text-body-secondary">{{description}}</p>
        <div class="row g-3">
          {{#each fields}}
          {{#if (eq type "switch")}}
          <div class="col-12"><div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="set-{{id}}"{{#if checked}} checked{{/if}}{{#if help}} aria-describedby="set-{{id}}-t"{{/if}}>
            <label class="form-check-label" for="set-{{id}}">{{label}}</label>
            {{#if help}}<div class="form-text" id="set-{{id}}-t">{{help}}</div>{{/if}}
          </div></div>
          {{else}}
          <div class="col-md-6">
            <label class="form-label" for="set-{{id}}">{{label}}</label>
            {{#if (eq type "select")}}
            <select class="form-select" id="set-{{id}}">{{#each options}}<option{{#if (eq this ../value)}} selected{{/if}}>{{this}}</option>{{/each}}</select>
            {{else}}
            <input class="form-control" id="set-{{id}}" type="{{type}}" value="{{value}}"{{#if readonly}} readonly{{/if}}{{#if help}} aria-describedby="set-{{id}}-t"{{/if}} autocomplete="off">
            {{/if}}
            {{#if help}}<div class="form-text" id="set-{{id}}-t">{{help}}</div>{{/if}}
          </div>
          {{/if}}
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
    <div class="d-flex justify-content-end mt-4"><button class="btn btn-primary" type="button" data-au-action="toast" data-au-type="info" data-au-message="Demostración: los cambios no se guardan.">Guardar cambios</button></div>
  </div>
</section>
