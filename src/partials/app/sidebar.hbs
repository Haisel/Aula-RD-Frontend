<aside class="au-sidebar offcanvas-lg offcanvas-start" id="au-sidebar" tabindex="-1" aria-label="Menú principal">
  <div class="offcanvas-header d-lg-none">
    <img src="img/brand/logo-horizontal-oscuro.svg" alt="Aula RD" height="34">
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#au-sidebar" aria-label="Cerrar menú"></button>
  </div>
  <nav class="au-sidebar-body" aria-label="Secciones">
    <div class="au-sidebar-brand d-none d-lg-flex">
      <a href="index.html" class="au-brand-full" aria-label="Aula RD, inicio"><img src="img/brand/logo-horizontal-oscuro.svg" alt="Aula RD"></a>
      <img class="au-brand-iso" src="img/brand/isotipo-oscuro.svg" alt="Aula RD">
      {{#if isSuperAdmin}}<span class="au-role-chip">Superadmin</span>{{/if}}
    </div>
    {{#if org}}
    <button class="au-tenant" type="button" aria-label="Cambiar de institución: {{org.name}}">
      <span class="au-avatar" aria-hidden="true">{{org.initials}}</span>
      <span class="au-tenant-text"><span class="au-tenant-name" data-au-bind="institution.name">{{org.name}}</span><small>Plan <span data-au-bind="institution.plan">{{org.plan}}</span></small></span>
      <i class="bi bi-chevron-expand" aria-hidden="true"></i>
    </button>
    {{/if}}
    {{#each nav}}
    {{#if section}}<div class="au-sidebar-section" role="presentation">{{section}}</div>{{/if}}
    <a class="nav-link{{#if active}} active{{/if}}" href="{{href}}"{{#if active}} aria-current="page"{{/if}} title="{{label}}">
      <i class="bi bi-{{icon}}{{#if active}}-fill{{/if}}" aria-hidden="true"></i><span class="au-nav-text">{{label}}</span>{{#if badge}}<span class="badge rounded-pill" aria-label="{{badge}} pendientes">{{badge}}</span>{{/if}}
    </a>
    {{/each}}
  </nav>
</aside>
